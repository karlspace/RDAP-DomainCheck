# Normalize line endings: store everything as LF in the repo and check it out
# as LF on every platform. Keeps the prettier --check CI gate stable and stops
# Windows contributors from committing CRLF (which fails the gate on Linux).
* text=auto eol=lf

# Binary assets — never normalize or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
